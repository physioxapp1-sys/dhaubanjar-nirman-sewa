# Copy to .env and fill in. Never commit .env.
SECRET_KEY=generate-a-long-random-string
DEBUG=False

ALLOWED_HOSTS=www.dhaubanjarnirmansewa.com.np,dhaubanjarnirmansewa.com.np
CSRF_TRUSTED_ORIGINS=https://www.dhaubanjarnirmansewa.com.np,https://dhaubanjarnirmansewa.com.np
CORS_ALLOWED_ORIGINS=https://www.dhaubanjarnirmansewa.com.np

# MySQL (cPanel prefixes both the database and the user with your account name)
DB_ENGINE=mysql
DB_NAME=madhyapu_dhaubanjar
DB_USER=madhyapu_dhaubanjar_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Enquiry notifications. Without EMAIL_HOST, mail is printed to the log
# instead of sent, which is fine for local work.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=info@dhaubanjarnirmansewa.com.np
ENQUIRY_NOTIFY_EMAILS=info@dhaubanjarnirmansewa.com.np

LOG_LEVEL=INFO
